#!/usr/bin/env bash
set -u

if [ "$#" -eq 0 ]; then
  printf 'Usage: pet-run COMMAND [ARG ...]\n' >&2
  exit 2
fi

pet_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
pet_notify="$pet_root/bin/pet-notify"
pet_python="$pet_root/.venv/bin/python"
export PYTHONPATH="$pet_root${PYTHONPATH:+:$PYTHONPATH}"
pet_session="$("$pet_python" -c 'import uuid; print(uuid.uuid4())')"
export PET_OWNER_PID="$$"
PET_OWNER_STARTED="$("$pet_python" - "$$" <<'PY_OWNER'
import sys
from pet_daemon.sessions.processes import process_identity
identity = process_identity(int(sys.argv[1]))
print(identity.started if identity else "")
PY_OWNER
)"
export PET_OWNER_STARTED
pet_call=command
pet_outcome=error

pet_lifecycle() {
  "$pet_python" - "$pet_session" "$1" "$pet_outcome" <<'PY_EVENT'
import sys
from pet_daemon.cli.notify import send
from pet_daemon.domain import SessionSource
from pet_daemon.sessions.processes import discover_owner
payload = {"kind": "event", "source": "cli", "session": sys.argv[1],
           "event": sys.argv[2], "outcome": sys.argv[3], "manual": True}
owner = discover_owner(SessionSource.COMMAND)
if owner:
    payload["owner"] = owner.packet()
send(payload)
PY_EVENT
}

pet_interrupt() {
  pet_outcome=cancelled
  pet_lifecycle interrupt
  if [ -n "${pet_child:-}" ]; then
    kill -TERM "$pet_child" 2>/dev/null || true
    wait "$pet_child" 2>/dev/null || true
  fi
  exit "$1"
}
trap 'pet_interrupt 130' INT
trap 'pet_interrupt 143' TERM
trap 'pet_lifecycle session_end' EXIT
"$pet_notify" intent --session "$pet_session" --text "$*"
"$pet_notify" --session "$pet_session" --status start --call "$pet_call" --tool "$*"
"$@" <&0 &
pet_child=$!
if wait "$pet_child"; then
  pet_result=0
  pet_outcome=success
  "$pet_notify" --session "$pet_session" --status done --call "$pet_call"
else
  pet_result=$?
  "$pet_notify" --session "$pet_session" --status error --call "$pet_call" --exit-code "$pet_result"
fi
exit "$pet_result"
