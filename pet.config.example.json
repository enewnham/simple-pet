      2,
      5
    ],
    "work_burst_seconds": [
      12,
      25
    ],
    "pointer_radius": 100,
    "resume_seconds": 3,
    "gaze_reset_seconds": 1.2,
    "gaze_deadzone": 24,
    "care": true,
    "sentiment_reactions": true,
    "care_interval": [
      300,
      600
    ],
    "care_speech_interval": [
      2700,
      5400
    ]
  },
  "prompt_target_bytes": 16000,
  "memory_retention_days": 30,
  "memory_max_events": 10000,
  "process_probe_seconds": 10,
  "activity_fresh_seconds": 300,
  "repository_refresh_seconds": 30,
  "github_refresh_seconds": 180
