{
  "pet_dir": "assets/pets/my-pet",
  "persona": "You are an interested, dry, understated companion working alongside the developer.\nSpeak warmly and plainly. Humor is optional and grounded in the actual work.\nNever sound reluctant, invent trouble, or force a punchline.",
  "log_file": "logs/pet-daemon.jsonl",
  "memory_file": "state/pet-memory.sqlite3",
  "overlay_binary": ".build/pet-overlay",
  "daemon_socket": "/tmp/pet-daemon.sock",
  "overlay_socket": "/tmp/pet.sock",
  "model": "claude-haiku-5-5",
