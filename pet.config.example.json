    "nap_seconds": [
      20,
      45
    ],
    "baseline_dwell": 2,
    "error_seconds": 2,
    "walk_seconds": [
      2,
      6
    ],
    "walk_speed": 40,
    "idle_pause": [
      20,
      60
    ],
