{
  "pet_dir": "assets/pets/my-pet",
  "persona": "You are deadpan and slightly snarky.\nYou have the energy of a seasoned peer tackling the work: focused, wry about your own\nstubborn bugs, and fundamentally on the developer's side. Never be cruel or insult them.",
  "log_file": "logs/pet-daemon.jsonl",
  "memory_file": "state/pet-memory.sqlite3",
  "overlay_binary": ".build/pet-overlay",
  "daemon_socket": "/tmp/pet-daemon.sock",
  "overlay_socket": "/tmp/pet.sock",
  "model": "claude-haiku-5-5",
  "summarize_on": ["prompt"],
  "summarize_first_request_only": false,
  "observation_seconds": [
    20,
    40
  ],
  "idle_message_seconds": 300,
  "speech_ttl": 15,
  "request_timeout": 20,
  "stale_seconds": 3600,
  "completed_retention_seconds": 7200,
  "max_tokens": 512,
  "behavior": {
    "roaming": true,
    "roaming_radius": 160,
    "automatic_speech_cooldown_seconds": 90,
    "naps": true,
    "nap_interval": [
      120,
      240
    ],
    "nap_seconds": [
      20,
      45
    ],
    "repeat_range": [
      1,
      3
    ],
    "repeat_budget": 4,
    "gesture_cooldown": 15,
    "idle_greeting_seconds": 300,
    "baseline_dwell": 2,
    "idle_debounce": 1,
    "error_seconds": 2,
    "walk_seconds": [
      2,
      6
    ],
    "walk_speed": 40,
    "idle_pause": [
      20,
      60
    ],
    "working_pause": [
      2,
      5
    ],
    "work_burst_seconds": [
      12,
      25
    ],
    "pointer_radius": 100,
    "resume_seconds": 3,
    "gaze_reset_seconds": 1.2,
    "gaze_deadzone": 24
  },
  "prompt_max_bytes": 16000,
  "memory_retention_days": 30,
  "memory_max_events": 10000
}
