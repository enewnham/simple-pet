#!/usr/bin/env python3
"""Forward native agent hook metadata to the pet daemon."""

import argparse
import json
import os
from pathlib import Path
import runpy
import sys


CLIENT = runpy.run_path(str(Path(__file__).resolve().parents[1] / "bin" / "pet-notify"))
COMMON_EVENTS = {
    "SessionStart": "session_start", "SessionEnd": "session_end",
    "UserPromptSubmit": "intent", "PreToolUse": "tool_start",
    "PostToolUse": "tool_done", "PostToolUseFailure": "tool_error",
    "Stop": "turn_done", "StopFailure": "turn_error", "Interrupt": "interrupt",
    "SubagentStart": "subagent_start", "SubagentStop": "subagent_done",
    "PermissionRequest": "waiting", "Elicitation": "waiting", "Notification": "waiting",
}
EVENTS = {
    "claude": {key: value for key, value in COMMON_EVENTS.items() if key != "Interrupt"},
    "codex": {key: value for key, value in COMMON_EVENTS.items()
              if key not in ("PostToolUseFailure", "StopFailure", "Elicitation", "Notification")},
    "cursor": {
        "sessionStart": "session_start", "sessionEnd": "session_end",
        "beforeSubmitPrompt": "intent", "preToolUse": "tool_start",
        "postToolUse": "tool_done", "postToolUseFailure": "tool_error", "stop": "turn_done",
        "subagentStart": "subagent_start", "subagentStop": "subagent_done",
        "afterAgentResponse": "progress", "afterAgentThought": "progress",
    },
}
INPUT_TOOLS = ("AskUserQuestion", "request_user_input", "RequestUserInput")
def string(*values):
    return next((value for value in values if isinstance(value, str) and value), "")


def excerpt(*values, limit=240):
    return " ".join(string(*values).split())[:limit]


def object_value(value):
    if isinstance(value, str):
        try:
            value = json.loads(value)
        except ValueError:
            return {}
    return value if isinstance(value, dict) else {}


def failed(value):
    if not isinstance(value, dict):
        return False
    code = value.get("exit_code", value.get("exitCode"))
    return value.get("isError") is True or value.get("is_error") is True or (type(code) is int and code != 0)


def update(harness, event, payload):
    if harness == "claude" and payload.get("cursor_version"):
        return None
    if event == "Notification" and payload.get("notification_type") not in ("permission_prompt", "elicitation_dialog"):
        return None
    normalized = EVENTS[harness][event]
    parent = ""
    aliases = []
    if harness == "cursor":
        session = string(payload.get("conversation_id"))
        if normalized in ("subagent_start", "subagent_done"):
            parent = string(payload.get("parent_conversation_id"), session)
            aliases = list(dict.fromkeys(value for value in
                           (payload.get("subagent_id"), payload.get("child_conversation_id"))
                           if isinstance(value, str) and value))
            session = string(payload.get("child_conversation_id"), payload.get("subagent_id"))
    else:
        session = string(payload.get("session_id"))
        agent = string(payload.get("agent_id"))
        if agent and (harness == "claude" or normalized in ("subagent_start", "subagent_done")):
            parent, session = session, agent
    if not session:
        return None
    result = {"kind": "event", "harness": harness, "session": session, "event": normalized}
    cwd = string(payload.get("cwd"))
    if cwd:
        result["repo"] = os.path.normpath(cwd)
    if parent and parent != session:
        result["parent"] = parent
    if aliases:
        result["aliases"] = aliases
    turn = string(payload.get("generation_id"), payload.get("turn_id"))
    if turn and normalized not in ("subagent_start", "subagent_done"):
        result["turn"] = turn
    call = string(payload.get("tool_use_id"), payload.get("tool_call_id"))
    if call and normalized in ("tool_start", "tool_done", "tool_error", "waiting"):
        result["call"] = call
    parent_call = string(payload.get("parent_tool_call_id"))
    if normalized in ("subagent_start", "subagent_done"):
        parent_call = string(parent_call, payload.get("tool_call_id"))
    if parent_call:
        result["parent_call"] = parent_call
    tool_name = string(payload.get("tool_name"))
    if tool_name:
        result["tool_name"] = tool_name
    tool_input = object_value(payload.get("tool_input"))
    command = string(tool_input.get("command"), tool_input.get("cmd"), tool_input.get("file_path"),
                     tool_input.get("path"), tool_input.get("description"))
    tool = excerpt(command, tool_name, limit=160)
    if tool:
        result["tool"] = tool
    if normalized == "intent":
        result["goal"] = excerpt(payload.get("prompt"))
    elif normalized == "subagent_start" and payload.get("task"):
        result["goal"] = excerpt(payload.get("task"))
    if normalized == "tool_start" and tool_name in INPUT_TOOLS:
        result["event"] = "waiting"
    response = payload.get("tool_response")
    if harness == "cursor":
        output = payload.get("tool_output")
        response = object_value(output) or output
    if normalized == "tool_done" and failed(response):
        result["event"] = "tool_error"
    status = payload.get("status")
    if normalized == "turn_done" and harness == "cursor":
        if status == "error":
            result["event"] = "turn_error"
        elif status == "aborted":
            result["event"] = "interrupt"
    interrupted = normalized == "tool_error" and payload.get("is_interrupt") is True
    if interrupted:
        result["event"] = "tool_done"
        result["outcome"] = "cancelled"
    if result["event"] in ("tool_error", "turn_error"):
        result["outcome"] = "error"
    elif result["event"] == "interrupt":
        result["outcome"] = "cancelled"
    elif normalized == "subagent_done" and harness == "cursor":
        result["outcome"] = {"error": "error", "aborted": "cancelled"}.get(status, "success")
    elif not interrupted and normalized in ("tool_done", "turn_done", "subagent_done"):
        result["outcome"] = "success"
    if result.get("outcome") != "error" and normalized in ("tool_done", "turn_done", "subagent_done", "progress"):
        progress = excerpt(payload.get("last_assistant_message"))
        if normalized != "tool_done":
            progress = excerpt(progress, payload.get("text"), payload.get("response"),
                               payload.get("thought"), payload.get("summary"))
        if progress:
            result["progress"] = progress
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("harness", choices=EVENTS)
    parser.add_argument("event")
    args = parser.parse_args()
    if args.event not in EVENTS[args.harness]:
        parser.error("unsupported hook event")
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    if os.environ.get("PET_COMMENTARY") != "1":
        result = update(args.harness, args.event, payload)
        if result:
            CLIENT["send"](result)
    response = {"continue": True} if args.harness == "cursor" and args.event == "beforeSubmitPrompt" else {}
    print(json.dumps(response))


if __name__ == "__main__":
    main()
