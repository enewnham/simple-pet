#!/usr/bin/env bash
set -e

pet_entry="$0"
while [ -L "$pet_entry" ]; do
  pet_directory="$(cd -- "$(dirname -- "$pet_entry")" && pwd)"
  pet_entry="$(readlink -- "$pet_entry")"
  case "$pet_entry" in
    /*) ;;
    *) pet_entry="$pet_directory/$pet_entry" ;;
  esac
done
pet_root="$(cd -- "$(dirname -- "$pet_entry")/.." && pwd)"
export PYTHONPATH="$pet_root${PYTHONPATH:+:$PYTHONPATH}"
exec "$pet_root/.venv/bin/python" -m pet_daemon.cli.notify "$@"
